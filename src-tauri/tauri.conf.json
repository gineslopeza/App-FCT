{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "App FCT",
  "version": "../package.json",
  "identifier": "es.ginesla.appfct",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5174",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "App FCT",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "publisher": "Ginés López Arribas",
    "copyright": "© 2026 Ginés López Arribas. Todos los derechos reservados.",
    "licenseFile": "../LICENSE",
    "category": "Education",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Spanish"]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "PENDIENTE_CLAVE_PUBLICA",
      "endpoints": ["https://github.com/gineslopeza/App-FCT/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
